# Copy to .env.deploy. Keep hashes in single quotes so dollar signs stay literal.
DEMO_USERNAME=demo
DEMO_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
INFRACLAIM_LLM_MODE=mock
DEPLOY_DATABASE_PATH=/data/infraclaim-mock.sqlite3
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8086
HTTPS_PORT=8446
SITE_ADDRESS=:80
# For a public host: set BIND_ADDRESS=0.0.0.0, ports 80/443,
# and SITE_ADDRESS to your real DNS name. Caddy obtains HTTPS certificates.
